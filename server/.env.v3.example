# V3/V4 后端配置示例（只列新增项，不覆盖现有 .env）
# ---------------------------------------------------------------------------
# SQLite 数据库文件。开发/测试/生产必须指向不同文件；不要提交到 git。
# 默认：<进程工作目录>/data/course-platform.sqlite
SCP_DB_PATH=data/course-platform.sqlite

# 会话 Cookie 是否带 Secure。默认 true；仅本地 http 开发可设为 0。
SCP_COOKIE_SECURE=1

# 邀请码 SHA-256（小写十六进制，逗号分隔），只保存哈希，不保存明文。
# 生成方式：node -e "console.log(require('node:crypto').createHash('sha256').update('你的邀请码').digest('hex'))"
INVITE_CODE_SHA256=

# 仅本地联调可用明文邀请码；生产只配置 INVITE_CODE_SHA256。
# INVITE_CODE=

# bcrypt cost，默认 12；生产不建议低于 12。
# BCRYPT_ROUNDS=12

# 只有前面有 N 层可信反代时才设置；默认 0，不信任 X-Forwarded-For。
# SCP_TRUST_PROXY_HOPS=0
